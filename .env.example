APP_ENV=development
HTTP_ADDRESS=:5000
HEALTH_ADDRESS=:8081

DATABASE_URL=postgres://postgres:123@localhost:5432/datadog?sslmode=disable

REDIS_ADDRESS=localhost:6380
REDIS_PASSWORD=
REDIS_DATABASE=0

VICTORIA_URL=http://localhost:8428

WORKER_TOKEN=change-me
WORKER_NAME=worker-local-01
WORKER_CONCURRENCY=8
API_BASE_URL=http://localhost:5000

SCHEDULER_BATCH_SIZE=100
SCHEDULER_INTERVAL=1s

# Either set an explicit location id, or let the scheduler resolve it by code.
PROBE_LOCATION_ID=
PROBE_LOCATION_CODE=local-dev

QUEUE_STREAM=probe_jobs
QUEUE_GROUP=probe_workers
QUEUE_DEAD_LETTER=probe_results_dead_letter
QUEUE_MAX_LEN=100000

CORS_ALLOWED_ORIGINS=http://localhost:2000

LOG_LEVEL=info
LOG_FORMAT=json

# Development only: allow probing private/loopback targets (SSRF guard off).
SSRF_ALLOW_PRIVATE=false
PING_PRIVILEGED=true

# ------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------
# Google console configuration:
#   Authorized JavaScript origin:  http://localhost:2000
#   Authorized redirect URI:       http://localhost:2000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth client secret (server-side only)
GOOGLE_CLIENT_SECRET=your-google-client-secret

GOOGLE_REDIRECT_URI=http://localhost:2000/api/auth/callback/google

# HS256 secret for access tokens. MUST be changed for production.
AUTH_JWT_SECRET=dev-insecure-jwt-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Cookie flags: leave domain empty for localhost; enable Secure behind TLS.
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false

# OTP: in dev mode the code is returned by the API and shown in the UI.
OTP_DEV_MODE=true
SMS_PROVIDER=log

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional local outbound proxy. Keep local services out of the proxy path.
# HTTP_PROXY=http://127.0.0.1:10808
# HTTPS_PROXY=http://127.0.0.1:10808
# NO_PROXY=localhost,127.0.0.1,::1,<WSL_IP>
# Server-side URL the Next.js Google callback route uses to reach the API.
API_INTERNAL_URL=http://localhost:5000
