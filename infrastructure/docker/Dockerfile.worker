FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/worker \
    ./apps/worker/cmd/worker

# The worker runs as root (distroless default) so the NET_RAW capability
# granted by compose applies to privileged ICMP sockets.
FROM gcr.io/distroless/static-debian12

COPY --from=builder /out/worker /worker

EXPOSE 8081

ENTRYPOINT ["/worker"]
