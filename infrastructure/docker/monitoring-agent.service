[Unit]
Description=Monitoring Agent
Documentation=https://docs.example.com/monitoring-agent
After=network.target

[Service]
Type=simple
User=nobody
Group=nogroup
ExecStart=/usr/bin/monitoring-agent
Restart=always
RestartSec=5
StartLimitInterval=10min
StartLimitBurst=5

Environment=MONITORING_STATE_DIR=/var/lib/monitoring-agent
Environment=MONITORING_LOG_LEVEL=info
Environment=MONITORING_LOG_FORMAT=json

[Install]
WantedBy=multi-user.target
