{
  "name": "monitoring-platform",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web:dev": "pnpm --filter web dev",
    "infra:up": "wsl docker compose -f docker-compose.local.yml up -d",
    "infra:down": "wsl docker compose -f docker-compose.local.yml down",
    "infra:logs": "wsl docker compose -f docker-compose.local.yml logs -f",
    "db:migrate": "wsl docker compose -f docker-compose.local.yml --profile tools run --rm migrate",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:test": "pnpm --filter web test"
  }
}
