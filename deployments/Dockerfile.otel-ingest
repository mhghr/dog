FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/otel-ingest ./cmd/otel-ingest

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /out/otel-ingest /otel-ingest
EXPOSE 4318
ENTRYPOINT ["/otel-ingest"]
