FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/monitoring-agent ./cmd/monitoring-agent

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/monitoring-agent /usr/bin/monitoring-agent
RUN mkdir -p /var/lib/monitoring-agent /etc/monitoring-agent
ENTRYPOINT ["/usr/bin/monitoring-agent"]
